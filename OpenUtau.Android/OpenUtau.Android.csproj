<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <AndroidMinSdkVersion>24</AndroidMinSdkVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AndroidApplication>True</AndroidApplication>
    <PackageId>com.stakira.openutau</PackageId>
    <ApplicationVersion>5</ApplicationVersion>
    <ApplicationVersionDisplayName>2.0.3</ApplicationVersionDisplayName>
    <AndroidEnableSdfConsumers>True</AndroidEnableSdfConsumers>
    <RunAotCompilation>false</RunAotCompilation>
    <AndroidLinkMode>None</AndroidLinkMode>
    <MonoAndroidResourcePrefix>Resources</MonoAndroidResourcePrefix>
    <AndroidAssetsPrefix>Assets</AndroidAssetsPrefix>
    <!-- AndroidSupportedAbis is no longer supported (XA0036); use RuntimeIdentifiers instead -->
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>
    <IsAndroid>true</IsAndroid>
  </PropertyGroup>

  <ItemGroup>
    <AndroidResource Include="Resources\drawable\*" />
    <AndroidAsset Include="Assets\**" />
  </ItemGroup>

  <!--
    Worldline native synthesis library for Classic/UTAU singing. The default
    classic renderer (WORLDLINE-R) and the default CLASSIC resampler both call
    into libworldline.so via DllImport("worldline"). This is an Android NDK
    build (bionic/arm64), not the desktop linux-arm64 binary. Rebuild with
    cpp/build_android.sh after changing the C++ sources.
  -->
  <ItemGroup>
    <AndroidNativeLibrary Include="..\runtimes\android\arm64-v8a\libworldline.so"
                          Abi="arm64-v8a" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.3" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.3" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <PackageReference Include="ReactiveUI" Version="24.2.0" />
    <PackageReference Include="ReactiveUI.Avalonia" Version="12.1.2" />
  </ItemGroup>

  <!--
    NOTE: Do NOT add onnxruntime.aar as an AndroidLibrary, and do NOT strip ABIs from the
    built APK. The NuGet package's own targets provide the arm64-v8a natives, and
    RuntimeIdentifiers above keeps the APK single-ABI. Deleting entries from a SIGNED apk
    with `zip -d` rewrites the archive and destroys the APK Signature Scheme v2/v3 blocks,
    making Android 11+ reject the install with INSTALL_FAILED_INVALID_APK ("package appears
    invalid") - this is what broke the v0.5.12 and v0.5.13 releases.
  -->

  <ItemGroup>
    <ProjectReference Include="..\OpenUtau.Core\OpenUtau.Core.csproj" />
    <ProjectReference Include="..\OpenUtau\OpenUtau.csproj">
      <AdditionalProperties>OutputType=Library;DefineConstants=ANDROID;IsAndroid=true</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

</Project>
