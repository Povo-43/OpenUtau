<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-android36.0</TargetFramework>
    <AndroidMinSdkVersion>24</AndroidMinSdkVersion>
    <SupportedOSPlatformVersion>24.0</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AndroidApplication>True</AndroidApplication>
    <PackageId>com.stakira.openutau</PackageId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationVersionDisplayName>1.0.0</ApplicationVersionDisplayName>
    <AndroidEnableSdfConsumers>True</AndroidEnableSdfConsumers>
    <RunAotCompilation>false</RunAotCompilation>
    <AndroidLinkMode>None</AndroidLinkMode>
    <MonoAndroidResourcePrefix>Resources</MonoAndroidResourcePrefix>
    <AndroidAssetsPrefix>Assets</AndroidAssetsPrefix>
    <AndroidSupportedAbis>arm64-v8a</AndroidSupportedAbis>
    <AndroidExtractNativeLibs>false</AndroidExtractNativeLibs>
  </PropertyGroup>

  <ItemGroup>
    <AndroidResource Include="Resources\drawable\*" />
    <AndroidAsset Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.3" />
    <PackageReference Include="NAudio.Core" Version="2.2.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.1.3" />
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <PackageReference Include="AvaloniaEdit.TextMate" Version="12.0.0" />
    <PackageReference Include="ReactiveUI" Version="24.2.0" />
    <PackageReference Include="ReactiveUI.Avalonia" Version="12.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenUtau.Core\OpenUtau.Core.csproj" />
    <ProjectReference Include="..\OpenUtau\OpenUtau.csproj">
      <AdditionalProperties>OutputType=Library;DefineConstants=ANDROID</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>

  <!-- Remove unwanted native library architectures from the APK after it's created -->
  <Target Name="StripUnwantedAbisFromApk" AfterTargets="_BuildApk" Condition="'$(AndroidTargetArch)' == 'arm64' And '$(AndroidPackageFormat)' == 'apk'">
    <PropertyGroup>
      <_ApkPath>$(OutputPath)$(PackageId)-Signed.apk</_ApkPath>
      <_StripCmd>zip -d "$(_ApkPath)" "lib/x86/*" "lib/x86_64/*" "lib/armeabi-v7a/*"</_StripCmd>
    </PropertyGroup>
    <Exec Command="$(_StripCmd)" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Message Importance="High" Text="Stripped unwanted native library architectures from APK" />
  </Target>

  <!-- Also strip from the publish APK -->
  <Target Name="StripUnwantedAbisFromPublishApk" AfterTargets="Publish" Condition="'$(AndroidTargetArch)' == 'arm64' And '$(AndroidPackageFormat)' == 'apk'">
    <PropertyGroup>
      <_PublishApkPath>$(PublishDir)$(PackageId)-Signed.apk</_PublishApkPath>
      <_PublishStripCmd>zip -d "$(_PublishApkPath)" "lib/x86/*" "lib/x86_64/*" "lib/armeabi-v7a/*"</_PublishStripCmd>
    </PropertyGroup>
    <Exec Command="$(_PublishStripCmd)" WorkingDirectory="$(MSBuildProjectDirectory)" />
    <Message Importance="High" Text="Stripped unwanted native library architectures from publish APK" />
  </Target>

</Project>